      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1thy87f0etwfrk18dpi360eyg6xf].[usr:Calculation_0834571176329216:qk]&quot;' value='SLA Compliance' />
          <alias key='&quot;[federated.1thy87f0etwfrk18dpi360eyg6xf].[usr:Calculation_0834571221213186:qk]&quot;' value='Escalation Rate' />
        </aliases>
      </column>
      <column caption='Assigned Agent' datatype='string' name='[Assigned_Agent]' role='dimension' type='nominal' />
      <column caption='SLA Compliance %' datatype='real' name='[Calculation_0834571176329216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [SLA_Status] = &apos;SLA_Met&apos; THEN 1 ELSE 0 END) / COUNT([SLA_Status]) / 100) * 100' />
      </column>
      <column caption='Total Breaches' datatype='integer' name='[Calculation_0834571220316161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [SLA_Status] = &apos;SLA_Breached&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Escalation Rate %' datatype='real' name='[Calculation_0834571221213186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [SLA_Status] = &apos;SLA_Breached&apos; THEN 1 ELSE 0 END) / COUNT([SLA_Status])' />
      </column>
      <column caption='Total Tickets' datatype='integer' name='[Calculation_0852987311202304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Ticket_ID])' />
      </column>
      <column caption='Medium Breach %' datatype='real' name='[Calculation_1602855420514304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [SLA_Status] = &quot;SLA_Breached&quot; THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([SLA_Status])' />
      </column>
